# Synthetic data only. Local stub mode requires no credentials.
INVESTIGATOR_MODE=stub
DATABASE_MODE=local
PGLITE_DATA_DIR=.data/spendwise
# Server-only settings; local stub mode leaves these empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DATABASE_URL=
DATABASE_READONLY_URL=
# Non-secret owner role name; application runtime has no migration password.
DATABASE_MIGRATION_ROLE=
# CLI-only: keep this out of the application runtime environment.
DATABASE_MIGRATION_URL=
# Hosted Auth.js: external operator config only; leave empty for loopback local mode.
AUTH_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# JSON map of github:<numeric account id> to explicit permissions and optional runIds.
# No grants are enabled by default. See worklog/elliot/APP-02.md.
SPENDWISE_ACCESS_GRANTS=
