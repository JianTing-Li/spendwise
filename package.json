{
  "name": "spendwise",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "eval:baseline": "node --import tsx evals/baseline.ts",
    "eval:real": "node --import tsx evals/real.ts",
    "eval:feasibility": "node --import tsx evals/feasibility.ts",
    "test:pg": "node --import tsx --test tests/pg-local.integration.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@electric-sql/pglite": "0.5.15",
    "@faker-js/faker": "10.6.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
